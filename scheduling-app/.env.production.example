# Frontend build configuration.
#
# Copy to `.env.production` on the machine that runs `npm run build`. Vite reads
# it automatically for production builds; `npm run dev` ignores it entirely, so
# local development is unaffected.
#
# IMPORTANT: this is baked into the bundle at build time, not read when the page
# loads. Change the API's address and you must rebuild — editing this file on a
# server that already has a `dist/` does nothing.

# Where the browser should send API calls. Include the /api suffix.
#
# Normally this is the same host the frontend is served from, with nginx
# proxying /api through to the backend on port 3001 — in which case a relative
# path is the simplest and most robust choice, because it keeps working if the
# hostname ever changes:
#
#   VITE_API_URL=/api
#
# Use an absolute URL only if the API is served from a different host, and make
# sure that host is listed in the backend's CORS_ORIGIN:
#
#   VITE_API_URL=https://your-instance.jetstream-cloud.org/api

VITE_API_URL=/api
