# ── Slack App Credentials ─────────────────────────────────────────────────────
# Create your app at https://api.slack.com/apps, then fill these in.

# Bot OAuth Token  (OAuth & Permissions > Bot Token Scopes, starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret  (Basic Information > App Credentials)
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token  (Basic Information > App-Level Tokens, requires connections:write scope, starts with xapp-)
# Only needed for Socket Mode — delete this line if using HTTP mode instead.
SLACK_APP_TOKEN=xapp-your-app-token-here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas: Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@catalyst.pfivkwq.mongodb.net/catalyst

# ── Server ────────────────────────────────────────────────────────────────────
# Port the REST API listens on. Frontend Vite dev server runs on 5173.
PORT=3001

# ── Authentication ────────────────────────────────────────────────────────────
# Signing key for session tokens. Without it the server falls back to a known
# development secret and refuses to start when NODE_ENV=production, because
# anyone who knows that fallback can mint a valid manager session.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later invalidates every active session — everyone logs in again.
JWT_SECRET=

# How long a session lasts. Optional; defaults to 12h.
# JWT_TTL=12h

# ── Deployment ────────────────────────────────────────────────────────────────
# Leave these unset for local development; the defaults are the dev setup.

# Enables production behaviour, including refusing to run the seed script and
# refusing to start without a real JWT_SECRET.
# NODE_ENV=production

# Origin allowed to call this API — scheme and host, no trailing slash. This is
# the address the browser loads the frontend from, not the API's own address.
# Comma-separate if more than one is ever needed. Defaults to the Vite dev
# server (http://localhost:5173).
# CORS_ORIGIN=https://your-instance.jetstream-cloud.org

# Set to 1 when running behind a reverse proxy (nginx). Without it every request
# looks like it came from the proxy, so the login rate limiter counts the whole
# studio as one client and one person's failed attempts throttle everybody.
# Only set this when a proxy really is in front — with it on and the port
# exposed directly, a client could spoof its own address.
# TRUST_PROXY=1
