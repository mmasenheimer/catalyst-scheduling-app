# ── Slack App Credentials ─────────────────────────────────────────────────────
# Create your app at https://api.slack.com/apps, then fill these in.

# Bot OAuth Token  (OAuth & Permissions > Bot Token Scopes, starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret  (Basic Information > App Credentials)
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token  (Basic Information > App-Level Tokens, requires connections:write scope, starts with xapp-)
# Only needed for Socket Mode — delete this line if using HTTP mode instead.
SLACK_APP_TOKEN=xapp-your-app-token-here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas: Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@catalyst.pfivkwq.mongodb.net/catalyst

# ── Server ────────────────────────────────────────────────────────────────────
# Port the REST API listens on. Frontend Vite dev server runs on 5173.
PORT=3001
